<?xml version="1.0" encoding="utf-8"?>
<!--  LinearLayout vertical + gravity="center": tudo fica no centro da tela, em qualquer aparelho.  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/pokedex_background" android:fitsSystemWindows="true" android:gravity="center" android:orientation="vertical" android:padding="24dp">
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="28dp" app:cardElevation="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="28dp">
            <ImageView android:layout_width="120dp" android:layout_height="120dp" android:contentDescription="@string/app_name" android:src="@drawable/ic_pokeball"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="@string/main_titulo" android:textColor="@color/pokemon_dark" android:textSize="32sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/main_descricao" android:textColor="@color/text_secondary" android:textSize="16sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbrirLista"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="@string/main_botao"
                android:textAlignment="center"
                android:textSize="16sp"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>